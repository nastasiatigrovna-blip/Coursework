// Prisma Schema для проекта "Рукодельница"
// Документация: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Перечисления (Enums)

enum UserRole {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING    // Создан, ожидает оплаты (не используется в MVP с имитацией)
  PAID       // Оплачен (устанавливается автоматически после имитации оплаты)
  PROCESSING // В обработке
  SHIPPED    // Отправлен
  DELIVERED  // Доставлен
  CANCELLED  // Отменён
}

enum ProductType {
  PHYSICAL      // Физическое изделие
  DIGITAL_PDF   // PDF-схема
  DIGITAL_VIDEO // Видео мастер-класс
  COMBO         // Комплект (изделие + PDF + видео)
}

// Модели (Таблицы)

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String   // Хеш пароля (bcrypt)
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Связи
  orders  Order[]
  accesses Access[]

  @@map("users") // Имя таблицы в БД
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique // URL-friendly идентификатор
  description String?
  createdAt   DateTime @default(now())

  // Связи
  products Product[]

  @@map("categories")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String      @db.Text
  price       Decimal     @db.Decimal(10, 2)
  type        ProductType
  categoryId  Int
  imageUrl    String
  pdfFileUrl  String?     // Для DIGITAL_PDF и COMBO
  videoUrl    String?     // Для DIGITAL_VIDEO и COMBO
  stock       Int         @default(0) // Остаток на складе (для PHYSICAL)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Связи
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  accesses   Access[]

  @@index([categoryId])
  @@index([type])
  @@map("products")
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int
  status          OrderStatus @default(PAID) // MVP: сразу "оплачен"
  totalPrice      Decimal     @db.Decimal(10, 2)
  customerName    String
  customerPhone   String
  deliveryAddress String?     // Для физических товаров
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Связи
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  accesses   Access[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int
  quantity    Int     @default(1)
  price       Decimal @db.Decimal(10, 2) // Цена на момент заказа
  productName String  // Название товара на момент заказа

  // Связи
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Access {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  orderId   Int
  grantedAt DateTime @default(now())

  // Связи
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // Пользователь не может иметь дубликаты доступа
  @@index([userId])
  @@index([productId])
  @@map("accesses")
}
